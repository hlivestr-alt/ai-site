# TEMPLATE ONLY. Supply real values through a protected environment file/secret store.
# Never deploy .env.local or TEST seed data with the production release.
APP_ENV=production
APP_BASE_URL=https://workspace.example.com
APP_BUILD_ID=reviewed-release-id
DATABASE_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
MAIL_PROVIDER=smtp
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_ENCRYPTION_KEY=
OPS_READINESS_TOKEN=
PLATFORM_OPERATOR_USER_IDS=
PLATFORM_OPERATOR_EMAILS=
ALLOWED_ORIGINS=https://workspace.example.com
# Enable only behind a proxy that overwrites forwarded headers.
TRUST_PROXY_HEADERS=0
AI_VIDEO_ENABLED=0
CLIPPER_ENABLED=0
WORKFLOWS_ENABLED=0
PAYMENTS_ENABLED=0
VIDEO_PROVIDER=byteplus
BYTEPLUS_ARK_API_KEY=
BYTEPLUS_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com
WAVESPEED_API_KEY=
WAVESPEED_VIDEO_BASE_URL=https://api.wavespeed.ai
WAVESPEED_SEEDANCE_MODEL=bytedance/seedance-2.5/text-to-video
WAVESPEED_REFERENCE_FETCH_VERIFIED=0
WAVESPEED_REFERENCE_URL_TTL_SECONDS=3600
CLIP_ANALYZER_PROVIDER=openai
WAVESPEED_LLM_BASE_URL=https://llm.wavespeed.ai/v1
WAVESPEED_CLIP_MODEL=openai/gpt-5.6-luna
CLIPPER_ANALYZER_CONFIGURED=0
# Attest private worker key/model presence; never copy its OpenAI key into the web app.
OPENAI_WORKER_CREDENTIAL_CONFIGURED=0
CLIP_ANALYZER_WORKER_CREDENTIAL_CONFIGURED=0
# Optional on a colocated operator host; read-only private worker preflight input.
PRIVATE_WORKER_ENV_FILE=
PAYMENT_PROVIDER=xendit
XENDIT_MODE=test
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BUSINESS_ID=
XENDIT_RETURN_BASE_URL=https://workspace.example.com
WORKFLOW_MAX_TOKENS=
ENABLE_TEST_BILLING=0
ENABLE_FAKE_VIDEO_PROVIDER=0
ENABLE_FAKE_PAYMENT_PROVIDER=0
ENABLE_FAKE_CLIP_ANALYZER=0
ENABLE_TEST_MAIL_FAILURE=0
ENABLE_BILLING_SUPPORT_CLI=0
DEV_DIAGNOSTIC_TOKEN=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=120000
SERVICE_STALE_SECONDS=180
BACKUP_STALE_HOURS=24
RESTORE_DRILL_STALE_DAYS=30
DISPATCHER_POLL_MS=1000
WORKFLOW_POLL_MS=1000
PROVIDER_MAX_CONCURRENCY=10
PROVIDER_WORKSPACE_CONCURRENCY=3
QUOTA_ACTIVE_JOBS=20
QUOTA_ACTIVE_WORKFLOWS=10
QUOTA_QUEUED_AI_VIDEOS=10
QUOTA_QUEUED_CLIPPER_JOBS=5
QUOTA_SOURCE_UPLOADS_DAILY=20
QUOTA_STORAGE_BYTES=21474836480
QUOTA_PRODUCT_ASSETS=500
PENDING_UPLOAD_RETENTION_HOURS=24
BACKUP_ROOT=/var/backups/ai-site-saas
# Use installed matching pg_dump/pg_restore by default. Container tools are optional.
POSTGRES_TOOLS_CONTAINER=
# Acceptance attestations stay 0 until the documented real checks pass.
BYTEPLUS_ACCEPTANCE_VERIFIED=0
OPENAI_ACCEPTANCE_VERIFIED=0
WAVESPEED_VIDEO_ACCEPTANCE_VERIFIED=0
WAVESPEED_CLIP_ACCEPTANCE_VERIFIED=0
