# Review paths/account/permissions on the deployment host. This file installs nothing.
[Unit]
Description=AI Site customer SaaS execution dispatcher
After=network-online.target ai-site-saas-web.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ai-site-saas
Group=ai-site-saas
WorkingDirectory=/srv/ai-site/saas
ExecStart=/usr/bin/node --env-file=/etc/ai-site-saas/runtime.env --import tsx /srv/ai-site/saas/scripts/dispatcher.ts
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/ai-site/saas/data
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
