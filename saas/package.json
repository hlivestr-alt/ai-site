{
  "name": "content-workspace-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200 -H 127.0.0.1",
    "start": "next start -p 3200 -H 127.0.0.1",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "playwright test tests/integration",
    "test:remote-storage": "playwright test -c playwright.remote-storage.config.ts",
    "test:browser": "playwright test",
    "test:restart": "node tests/restart-acceptance.mjs",
    "test:clipper-acceptance": "node tests/clipper-acceptance.mjs",
    "test:video-restart": "node tests/video-restart-acceptance.mjs",
    "test:content-restart": "node tests/content-restart-acceptance.mjs",
    "test:schema-bootstrap": "node tests/schema-bootstrap.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs up",
    "db:status": "node --env-file=.env.local scripts/migrate.mjs status",
    "db:seed:test": "node --env-file=.env.local scripts/seed-test.mjs",
    "storage:init": "node --env-file=.env.local scripts/storage-init.mjs",
    "storage:cleanup": "node --env-file=.env.local scripts/cleanup-pending.mjs",
    "content:reconcile": "node --env-file=.env.local --import tsx scripts/content-reconcile.ts",
    "dispatcher": "node --env-file=.env.local --import tsx scripts/dispatcher.ts",
    "workflow:dispatcher": "node --env-file=.env.local --import tsx scripts/workflow-dispatcher.ts",
    "test:workflow-restart": "node tests/workflow-restart-acceptance.mjs",
    "worker:admin": "node --env-file=.env.local scripts/worker-admin.mjs",
    "billing:seed:test": "node --env-file=.env.local --import tsx scripts/billing-seed-test.ts",
    "billing:support": "node --env-file=.env.local --import tsx scripts/billing-support.ts",
    "billing:reconcile": "node --env-file=.env.local --import tsx scripts/billing-reconcile.ts",
    "test:billing-restart": "node tests/billing-restart-acceptance.mjs",
    "operations": "node --env-file=.env.local --import tsx scripts/operations.ts",
    "preflight:external": "node --env-file=.env.local --import tsx scripts/operations.ts external-preflight",
    "preflight:production": "node --env-file=.env.local --import tsx scripts/operations.ts production-preflight",
    "backup": "node --env-file=.env.local --import tsx scripts/backup.ts",
    "test:phase9": "node tests/phase9-acceptance.mjs",
    "ops:audit": "node --env-file=.env.local --import tsx scripts/operations.ts audit",
    "storage:audit": "node --env-file=.env.local --import tsx scripts/operations.ts storage-audit",
    "backup:database": "node --env-file=.env.local --import tsx scripts/backup.ts create",
    "backup:verify": "node --env-file=.env.local --import tsx scripts/backup.ts verify",
    "backup:restore": "node --env-file=.env.local --import tsx scripts/backup.ts restore",
    "billing:catalog": "node --env-file=.env.local --import tsx scripts/billing-catalog.ts",
    "external:preflight": "node --env-file=.env.local --import tsx scripts/operations.ts external-preflight",
    "wavespeed:preflight": "node --env-file=.env.local --import tsx scripts/wavespeed-preflight.ts",
    "wavespeed:video-smoke": "node --env-file=.env.local --import tsx scripts/wavespeed-video-smoke.ts",
    "production:preflight": "node --env-file=.env.local --import tsx scripts/operations.ts production-preflight",
    "test:performance-smoke": "node tests/phase9-query-review.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
