# Separate local SaaS database; never point this at Outreach or any internal DB.
DATABASE_URL=
TEST_DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
APP_BASE_URL=http://127.0.0.1:3200
APP_ENV=local
MAIL_MODE=development_file
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
# Optional browser signing endpoint. Empty preserves single-PC loopback URLs.
# Remote testing: https://storage-test.proyaofficial.com (APP_ENV stays local).
OBJECT_STORAGE_PUBLIC_ENDPOINT=
# Exact browser origins for the local SigV4 gateway and private bucket CORS.
# Remote testing: http://127.0.0.1:3200,https://ai-test.proyaofficial.com
OBJECT_STORAGE_ALLOWED_ORIGINS=http://127.0.0.1:3200
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=saas-media-dev
TEST_OBJECT_STORAGE_BUCKET=saas-media-test
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# The access identifier is public; it must differ from the private signing secret.
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=524288000
PENDING_UPLOAD_RETENTION_HOURS=24
FAILED_UPLOAD_RETENTION_HOURS=24
DEV_DIAGNOSTIC_TOKEN=
WORKER_LEASE_SECONDS=120
JOB_RETRY_BASE_MS=5000
DISPATCHER_POLL_MS=1000
VIDEO_PROVIDER=byteplus
ENABLE_FAKE_VIDEO_PROVIDER=0
BYTEPLUS_ARK_API_KEY=
BYTEPLUS_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com
# Additional provider. Set VIDEO_PROVIDER=wavespeed to select this policy.
WAVESPEED_API_KEY=
WAVESPEED_VIDEO_BASE_URL=https://api.wavespeed.ai
WAVESPEED_SEEDANCE_MODEL=bytedance/seedance-2.5/text-to-video
# Keep 0 until the exact storage hostname has verified external/provider fetch access.
WAVESPEED_REFERENCE_FETCH_VERIFIED=0
WAVESPEED_REFERENCE_URL_TTL_SECONDS=3600
MAX_GENERATED_VIDEO_BYTES=268435456
MAX_CLIPPER_SOURCE_BYTES=10737418240
MAX_CLIPPER_OUTPUT_BYTES=268435456
# Local test mode only; routes fake jobs to CLIPPER_TEST_V1.
ENABLE_FAKE_CLIP_ANALYZER=0
# Select openai or wavespeed for real workers. No automatic model fallback.
CLIP_ANALYZER_PROVIDER=openai
WAVESPEED_LLM_BASE_URL=https://llm.wavespeed.ai/v1
WAVESPEED_CLIP_MODEL=openai/gpt-5.6-luna

# Phase 7. Production prices are not seeded. Keep simulation flags disabled outside local tests.
ENABLE_TEST_BILLING=0
BILLING_QUOTE_TTL_MINUTES=15
PAYMENT_PROVIDER=xendit
ENABLE_FAKE_PAYMENT_PROVIDER=0
FAKE_PAYMENT_WEBHOOK_SECRET=
ENABLE_BILLING_SUPPORT_CLI=0
# This phase supports TEST keys and sandbox sessions only.
XENDIT_MODE=test
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BUSINESS_ID=
XENDIT_RETURN_BASE_URL=

# Phase 8. Required deliberately in production; local default ceiling is 100000.
WORKFLOW_MAX_TOKENS=
WORKFLOW_POLL_MS=1000

# Phase 9. Never enable simulations/diagnostics in staging or production.
MAIL_PROVIDER=development_file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_ENCRYPTION_KEY=
PLATFORM_OPERATOR_USER_IDS=
PLATFORM_OPERATOR_EMAILS=
OPS_READINESS_TOKEN=
AI_VIDEO_ENABLED=1
CLIPPER_ENABLED=1
# Visual rerenders reuse saved analysis; internal-beta pricing is versioned.
CLIPPER_VARIATION_ENABLED=1
WORKFLOWS_ENABLED=1
PAYMENTS_ENABLED=1
CLIPPER_ANALYZER_CONFIGURED=0
OPENAI_WORKER_CREDENTIAL_CONFIGURED=0
# General worker credential attestation. WaveSpeed also requires a matching model above.
CLIP_ANALYZER_WORKER_CREDENTIAL_CONFIGURED=0
PRIVATE_WORKER_ENV_FILE=
SERVICE_STALE_SECONDS=180
BACKUP_STALE_HOURS=24
RESTORE_DRILL_STALE_DAYS=30
QUOTA_ACTIVE_JOBS=20
QUOTA_ACTIVE_WORKFLOWS=10
QUOTA_QUEUED_AI_VIDEOS=10
QUOTA_QUEUED_CLIPPER_JOBS=5
QUOTA_SOURCE_UPLOADS_DAILY=20
QUOTA_STORAGE_BYTES=21474836480
QUOTA_PRODUCT_ASSETS=500
PROVIDER_MAX_CONCURRENCY=10
PROVIDER_WORKSPACE_CONCURRENCY=3
RATE_LIMIT_WINDOW_SECONDS=900
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=120000
# Explicitly select only the SaaS Postgres container for the local backup drill.
POSTGRES_TOOLS_CONTAINER=
BACKUP_ROOT=
BYTEPLUS_ACCEPTANCE_VERIFIED=0
OPENAI_ACCEPTANCE_VERIFIED=0
WAVESPEED_VIDEO_ACCEPTANCE_VERIFIED=0
WAVESPEED_CLIP_ACCEPTANCE_VERIFIED=0
XENDIT_SANDBOX_ACCEPTANCE_VERIFIED=0
PRODUCTION_SUPERVISION_VERIFIED=0
PRODUCTION_STORAGE_VERIFIED=0
PRODUCTION_MAIL_VERIFIED=0
PUBLIC_CALLBACKS_VERIFIED=0

# Workspace-owned Outreach; real outbound connections are not yet certified.
OUTREACH_ENABLED=1
# Test provider requires an isolated phase_e test database and APP_ENV=test/local.
ENABLE_FAKE_OUTREACH_PROVIDER=0
