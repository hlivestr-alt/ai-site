# Separate local SaaS database; never point this at Outreach or any internal DB.
DATABASE_URL=
TEST_DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
APP_BASE_URL=http://127.0.0.1:3200
APP_ENV=local
MAIL_MODE=development_file
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=saas-media-dev
TEST_OBJECT_STORAGE_BUCKET=saas-media-test
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=524288000
PENDING_UPLOAD_RETENTION_HOURS=24
DEV_DIAGNOSTIC_TOKEN=
WORKER_LEASE_SECONDS=120
JOB_RETRY_BASE_MS=5000
DISPATCHER_POLL_MS=1000
VIDEO_PROVIDER=byteplus
ENABLE_FAKE_VIDEO_PROVIDER=0
BYTEPLUS_ARK_API_KEY=
BYTEPLUS_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com
MAX_GENERATED_VIDEO_BYTES=268435456
MAX_CLIPPER_SOURCE_BYTES=10737418240
MAX_CLIPPER_OUTPUT_BYTES=268435456
# Local test mode only; routes fake jobs to CLIPPER_TEST_V1.
ENABLE_FAKE_CLIP_ANALYZER=0

# Phase 7. Production prices are not seeded. Keep simulation flags disabled outside local tests.
ENABLE_TEST_BILLING=0
BILLING_QUOTE_TTL_MINUTES=15
PAYMENT_PROVIDER=xendit
ENABLE_FAKE_PAYMENT_PROVIDER=0
FAKE_PAYMENT_WEBHOOK_SECRET=
ENABLE_BILLING_SUPPORT_CLI=0
# This phase supports TEST keys and sandbox sessions only.
XENDIT_MODE=test
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BUSINESS_ID=
XENDIT_RETURN_BASE_URL=
