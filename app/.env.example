# Read-only MiniMax H3 status adapter; loopback HTTP only.
# Do not use NEXT_PUBLIC_ for service addresses or credentials.
H3_BASE_URL=http://127.0.0.1:8787
H3_BRIDGE_URL=http://127.0.0.1:8788
CLIPPER_API_URL=http://127.0.0.1:8765
OUTREACH_API_URL=http://127.0.0.1:4000
OUTREACH_QUEUE_ENABLED=false
# Server-only sending gate. It is independent of the optional AI Site login.
# Safe defaults; set the desired values in ignored .env.local and restart AI Site.
AUTH_ENABLED=true
# Run configure-login.ps1 to write these into ignored .env.local; never put a plaintext password here.
AI_SITE_PASSWORD_HASH=
AI_SITE_SESSION_SECRET=
# Outreach list/detail API GETs can update expired campaigns, so Phase 2 uses server-only read-only SQL.
# Supply the local PostgreSQL URL in ignored .env.local; do not commit credentials.
OUTREACH_DATABASE_URL=
