SAAS_BASE_URL=http://127.0.0.1:3200
# Loaded automatically by python worker_agent.py. Missing/blank process values
# use this file; nonempty process values intentionally override it.
# Paste the existing private worker credential here; never commit the real .env.
WORKER_TOKEN=
WORKER_MAX_CONCURRENCY=1
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=20
WORKER_WORK_DIR=./data/jobs
WORKER_AGENT_VERSION=phase5-worker-1
# Production jobs require a separately provisioned CLIPPER_V1 credential.
CLIP_ANALYZER_PROVIDER=openai
OPENAI_API_KEY=
# Explicit structured-output model; do not silently substitute a model.
OPENAI_CLIP_MODEL=
# Set CLIP_ANALYZER_PROVIDER=wavespeed for the additional analyzer.
# This is a WaveSpeed credential, never an OPENAI_API_KEY substitute.
WAVESPEED_API_KEY=
WAVESPEED_LLM_BASE_URL=https://llm.wavespeed.ai/v1
WAVESPEED_CLIP_MODEL=openai/gpt-5.6-luna
CLIPPER_WHISPER_MODEL=large-v3-turbo
CLIPPER_WHISPER_REVISION=installed-local-v1
CLIPPER_WHISPER_DEVICE=cuda
CLIPPER_WHISPER_COMPUTE=float16
MAX_CLIPPER_SOURCE_BYTES=10737418240
MAX_CLIPPER_OUTPUT_BYTES=268435456
WORKER_MAX_LOCAL_JOB_BYTES=42949672960
WORKER_TERMINAL_RETENTION_SECONDS=86400
# Fake analysis is restricted to explicitly provisioned CLIPPER_TEST_V1 jobs.
ENABLE_FAKE_CLIP_ANALYZER=0
